#!/usr/bin/env bash
# The harness CLI: the parts of working on linuxserver-playground that must give the same answer every time,
# whichever agent (or person) runs them. The guides in guides/ say when to use each command.
#
#   ./harness whoami [--refresh] [--brief]   who you are to the org: member or contributor (writes .harness/profile.json)
#   ./harness doctor                         which local tools you have, and what a missing one rules out
#   ./harness core                           clone the infrastructure repos (and the workspace) into repos/
#   ./harness get <repo>...                  clone more repos on demand (docker-<name>, or just <name>)
#   ./harness all                            clone every repo in the org (about 230; heavy)
#   ./harness sync                           fast-forward every clone; report repos gone from the org
#   ./harness fork <repo>                    contributors: fork a cloned repo and make the fork origin
#   ./harness setup <repo>                   install one repo's dev environment (venv, npm, cargo)
#   ./harness snapshot                       one consistent picture of the org from control, the hub and GitHub
#   ./harness control <path>                 GET one of control's JSON routes (api/queue.json, api/builds/<owner>/<repo>/<run>.json, ...)
#   ./harness lookup <image>                 one image at a glance: branches, builds, tests, PRs, issues, dependents, why the newest build exists
#   ./harness data                           check out the hub's data branch into repos/hub/data: the whole fleet in one clone, for fleet-wide questions
#   ./harness try <image> [tag] | --build <repo> | --stop [image]   [--env KEY=VALUE]...
#                                            run a published or locally built image in Docker and wait for init
#                                            (--env adds variables: DOCKER_MODS=… to try a mod on the image)
#   ./harness render <repo> [--in-place]     builder check, then render the generated files (out of tree by default)
#   ./harness validate <repo> [--no-build]   the repo's own validation list; results go to .harness/validation/
#   ./harness draft pr|issue|request|review|proposal <repo-or-name> [number]
#                                            fill a template into .harness/drafts/ for you to read before anything is filed
#                                            (issue: a bug; request: a feature, topic or removal; proposal: a new image)
#   ./harness allow push|force-push|tag|delete <repo> [minutes]
#                                            members: let the guard hook pass one protected action for a while (default 30 min)
#   ./harness pages check <repo>             is the repo's Pages site serving its newest deploy? (the hub, the site, docker-*)
#   ./harness pages reset <repo> [--yes]     org owners: delete and recreate a stuck Pages site, then redeploy it
#                                            (prints the plan and changes nothing without --yes)
#   ./harness labs form <name>               the filled proposal draft as a prefilled link to the Labs proposal form
#   ./harness labs scaffold <issue>          a v2 image repo from a Labs proposal, in .harness/labs/<name>/
#   ./harness labs try <issue> [--fresh] | --stop <name>
#                                            build the scaffold (kept with your edits; --fresh rewrites it) and run it
#                                            sandboxed on localhost: no host mounts, no credentials
#   ./harness labs accept <issue> [--fresh]  Labs members: write the commands that elevate a proposal (accept.sh), run nothing
#
# Nothing here opens an issue or a pull request, posts a comment or pushes. Those stay with the person.
set -euo pipefail

VERSION=0.2.0
ORG=${HARNESS_ORG:-linuxserver-playground}
# The org that holds the shared pipeline (workflows, builder, ci, base images) whichever org ORG is.
PIPELINE_ORG=${HARNESS_PIPELINE_ORG:-linuxserver-playground}
LABS_ORG=${HARNESS_LABS_ORG:-linuxserverlabs-playground}
LABS_CONTROL=${HARNESS_LABS_CONTROL_URL:-https://labs-ci.thelamer.duckdns.org:8443}
LABS_HUB=${HARNESS_LABS_HUB_URL:-https://$LABS_ORG.github.io/hub}
LABS_SITE=${HARNESS_LABS_SITE_URL:-https://$LABS_ORG.github.io/site}
LABS_PROPOSALS=$LABS_ORG/proposals
# HARNESS_ORG=$LABS_ORG points snapshot, lookup, control and try at Labs: its control, hub, site and namespace.
if [[ "$ORG" == "$LABS_ORG" ]]; then
  CONTROL=${HARNESS_CONTROL_URL:-$LABS_CONTROL}
  HUB=${HARNESS_HUB_URL:-$LABS_HUB}
  SITE=${HARNESS_SITE_URL:-$LABS_SITE}
else
  CONTROL=${HARNESS_CONTROL_URL:-https://ci.thelamer.duckdns.org:8443}
  HUB=${HARNESS_HUB_URL:-https://linuxserver-playground.github.io/hub}
  SITE=${HARNESS_SITE_URL:-https://linuxserver-playground.github.io/site}
fi
REGISTRY=ghcr.io/$ORG
BUILDER_IMAGE=${HARNESS_BUILDER_IMAGE:-ghcr.io/$PIPELINE_ORG/builder:latest}
SHELLCHECK_IMAGE=koalaman/shellcheck:stable
CORE=(workspace builder workflows ci hub site control dumper .github docker-mods)
GENERATED=(README.md AGENTS.md LICENSE .github/FUNDING.yml root/donate.txt .github/workflows/build.yml .github/workflows/pr-report.yml)
PYTHON_REPOS=(builder workflows ci hub control)

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repos_dir=${REPOS_DIR:-$here/repos}
state=$here/.harness
profile=$state/profile.json

say() { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
need() { for tool in "$@"; do have "$tool" || die "$tool is required (run ./harness doctor)"; done; }

control_fetch() { fetch "$CONTROL/${1#/}"; }
fetch() { curl -fsS --max-time 30 "$1"; }

# The directory a repo is cloned into: .github would be hidden, so it is dot-github, as in the workspace.
repo_dir() {
  local name=$1
  [[ "$name" == ".github" || "$name" == "dot-github" ]] && { echo "$repos_dir/dot-github"; return; }
  echo "$repos_dir/$name"
}

# Accept docker-sonarr, sonarr or a path under repos/; answer the org repo name.
resolve_repo() {
  local name=${1%/}
  name=${name##*/}
  [[ "$name" == "dot-github" ]] && { echo ".github"; return; }
  if [[ -e "$(repo_dir "$name")/.git" ]] || gh repo view "$ORG/$name" --json name >/dev/null 2>&1; then
    echo "$name"
  elif gh repo view "$ORG/docker-$name" --json name >/dev/null 2>&1; then
    echo "docker-$name"
  else
    die "no repo $ORG/$name or $ORG/docker-$name"
  fi
}

# The image name for a repo or image argument: docker-sonarr -> sonarr.
image_name() { local name=${1%/}; name=${name##*/}; echo "${name#docker-}"; }

role() { [[ -f "$profile" ]] && jq -r '.role' "$profile" || echo "unknown"; }

# ---------------------------------------------------------------------------------------------------- whoami

cmd_whoami() {
  local refresh=false brief=false
  for arg in "$@"; do
    case "$arg" in
      --refresh) refresh=true ;;
      --brief) brief=true ;;
      *) die "unknown option $arg" ;;
    esac
  done
  mkdir -p "$state"
  if ! $refresh && [[ -f "$profile" ]]; then
    local checked age
    checked=$(jq -r '.checked_epoch // 0' "$profile")
    age=$(( $(date +%s) - checked ))
    if (( age < 86400 )) && [[ "$(jq -r '.version' "$profile")" == "$VERSION" ]]; then
      # A cached profile is only good while gh is still signed in as the same account.
      local cached live=""
      cached=$(jq -r '.login // ""' "$profile")
      have gh && live=$(gh api user --jq .login 2>/dev/null || true)
      if [[ -n "$cached" && -n "$live" && "$live" != "$cached" ]]; then
        warn "the cached profile is $cached's but gh is signed in as $live: checking the role again"
      else
        briefing "$brief"
        return
      fi
    fi
  fi

  local login="" role="contributor" state_="none" org_role="" note="" scopes="" labs_member=false
  if ! have gh; then
    note="gh is not installed: install the GitHub CLI and run 'gh auth login'. Until then you can only read the public data sources."
    role="anonymous"
  elif ! gh auth status >/dev/null 2>&1; then
    note="gh is not signed in: run 'gh auth login'. Until then you can only read the public data sources."
    role="anonymous"
  else
    login=$(gh api user --jq .login)
    scopes=$(gh auth status 2>&1 | sed -n "s/.*Token scopes: //p" | tr -d "'" | head -n1)
    local out rc=0
    out=$(gh api "user/memberships/orgs/$ORG" --jq '.state + " " + .role' 2>&1) || rc=$?
    if (( rc == 0 )); then
      state_=${out%% *}
      org_role=${out##* }
      if [[ "$state_" == "active" ]]; then
        role="member"
      else
        note="your invitation to $ORG is $state_: accept it at https://github.com/orgs/$ORG/invitation, then run ./harness whoami --refresh. Until then you are on the contributor path."
      fi
    elif [[ "$out" == *"HTTP 403"* ]]; then
      note="your gh token cannot read org memberships: run 'gh auth refresh -s read:org', then ./harness whoami --refresh. Treated as a contributor until then."
    elif [[ "$out" != *"HTTP 404"* ]]; then
      note="could not read your membership ($out). Treated as a contributor; try ./harness whoami --refresh."
    fi
    # Labs is its own org with its own members (its admins team): accepting a proposal needs membership there.
    [[ "$(gh api "user/memberships/orgs/$LABS_ORG" --jq .state 2>/dev/null || true)" == active ]] && labs_member=true
    if [[ "$role" == "member" && "$scopes" != *workflow* ]]; then
      note="your gh token has no 'workflow' scope, so pushes that touch .github/workflows will be refused: run 'gh auth refresh -s workflow'."
    fi
  fi

  jq -n --arg login "$login" --arg role "$role" --arg membership "$state_" --arg org_role "$org_role" \
    --arg scopes "$scopes" --arg note "$note" --arg version "$VERSION" --arg org "$ORG" \
    --arg labs_org "$LABS_ORG" --argjson labs_member "$labs_member" \
    --arg checked "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson epoch "$(date +%s)" \
    '{login: $login, role: $role, org: $org, membership: $membership, org_role: $org_role, scopes: $scopes,
      labs_org: $labs_org, labs_member: $labs_member,
      note: $note, version: $version, checked_at: $checked, checked_epoch: $epoch}' >"$profile"
  briefing "$brief"
}

briefing() {
  local brief=$1 login role note
  login=$(jq -r '.login' "$profile")
  role=$(jq -r '.role' "$profile")
  note=$(jq -r '.note' "$profile")
  say "harness $VERSION: ${login:-not signed in} is a ${role} of $ORG (checked $(jq -r '.checked_at' "$profile"))."
  [[ -n "$note" ]] && say "NOTE: $note"
  case "$role" in
    member)
      say "Path: member. Read guides/roles/member.md. You may create repos; changes to existing repos go up as a pull request for review."
      [[ "$(jq -r '.org_role // empty' "$profile")" == admin ]] &&
        say "Owner: you are an owner of $ORG, so the owner-only steps are open to you (a Pages site that will not publish: guides/playbooks/fleet-ops.md)."
      if [[ "$(jq -r '.labs_member // false' "$profile")" == true ]]; then
        say "Labs: you are a member of $LABS_ORG too: ./harness labs try|accept <issue> for its proposals (guides/playbooks/labs-accept.md)."
      else
        say "Labs: you are not a member of $LABS_ORG, so you can try its proposals (./harness labs try) but not accept them."
      fi
      ;;
    *)
      say "Path: contributor. Read guides/roles/contributor.md. You work in forks (./harness fork <repo>) and open pull requests; new images are proposed to $LABS_ORG (guides/roles/labs-developer.md when it is the person's own app)."
      ;;
  esac
  if [[ "$brief" == true ]]; then
    say "Pick the playbook for the request from the table in AGENTS.md before acting. Drafts go to .harness/drafts/; the person files them."
    return
  fi
  local cloned
  cloned=$( (find "$repos_dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null || true) | wc -l)
  say "Repos cloned in repos/: $cloned (./harness core for the infrastructure set, ./harness get <repo> for more)."
}

# ---------------------------------------------------------------------------------------------------- doctor

cmd_doctor() {
  local missing=0
  row() { printf '%-10s %-8s %s\n' "$1" "$2" "$3"; }
  check() {
    local tool=$1 why=$2 version=""
    if have "$tool"; then
      version=$("$tool" --version 2>/dev/null | head -n1 || true)
      row "$tool" ok "${version:0:60}"
    else
      row "$tool" MISSING "$why"
      missing=$((missing + 1))
    fi
  }
  check git "nothing works without it"
  check gh "no role detection, cloning, forks, issues or PRs"
  check jq "the harness CLI and its hooks need it"
  check curl "no live data from control or the hub"
  check docker "no local builds, runs, builder check or render: most playbooks that change an image"
  if have docker; then
    if docker info >/dev/null 2>&1; then
      row docker-up ok "daemon reachable"
      if docker buildx version >/dev/null 2>&1; then row buildx ok "$(docker buildx version | head -n1 | cut -c1-60)"; else row buildx MISSING "no multi-arch builds"; fi
      local other=aarch64
      [[ "$(uname -m)" == "aarch64" || "$(uname -m)" == "arm64" ]] && other=x86_64
      if [[ -e /proc/sys/fs/binfmt_misc/qemu-$other ]]; then
        row qemu ok "can build and run the $other image locally (slow)"
      else
        row qemu absent "only the $(uname -m) image builds locally; the PR build covers the other arch (docker run --privileged --rm tonistiigi/binfmt --install all to add it)"
      fi
    else
      row docker-up DOWN "the daemon is not reachable by your user"
      missing=$((missing + 1))
    fi
  fi
  check python3 "no builder, hub, control, ci or workflows checks"
  if have python3; then
    python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' ||
      row python3 OLD "3.12+ needed (3.13 preferred: the hub and control use it)"
  fi
  check node "no site checks"
  if have node; then
    node -e 'process.exit(parseInt(process.versions.node) >= 22 ? 0 : 1)' || row node OLD "Node 22+ needed (CI uses 24)"
  fi
  if have shellcheck; then row shellcheck ok "$(shellcheck --version | sed -n 2p)"; else row shellcheck docker "not installed; validate runs it from the $SHELLCHECK_IMAGE image"; fi
  check cargo "no dumper checks (rarely needed)"
  say ""
  if have gh && gh auth status >/dev/null 2>&1; then
    say "gh: signed in as $(gh api user --jq .login); scopes: $(gh auth status 2>&1 | sed -n "s/.*Token scopes: //p" | head -n1)"
  else
    say "gh: not signed in (gh auth login)"
  fi
  if (( missing == 0 )); then say "Everything the harness uses is here."; else say "$missing missing: see the right-hand column for what that rules out."; fi
}

# ---------------------------------------------------------------------------------------------------- clones

clone_or_update() {
  local name=$1 dir
  dir=$(repo_dir "$name")
  if [[ ! -e "$dir/.git" ]]; then
    local args=(--quiet --filter=blob:none)
    # docker-mods holds one branch per mod: clone master only and fetch a mod's branch when it is needed.
    [[ "$name" == "docker-mods" ]] && args+=(--single-branch)
    gh repo clone "$ORG/$name" "$dir" -- "${args[@]}"
    # Image repos: a read-only remote to the linuxserver original, so the build-failure triage can compare
    # heads (git fetch linuxserver). Never push to it; the guard hook refuses anyway. docker-mods is ours alone.
    if [[ "$name" == docker-* && "$name" != docker-mods ]]; then
      git -C "$dir" remote add linuxserver "https://github.com/linuxserver/$name.git" 2>/dev/null || true
    fi
    say "cloned   $name"
    return
  fi
  local remote=origin default current
  git -C "$dir" remote get-url upstream >/dev/null 2>&1 && remote=upstream
  git -C "$dir" fetch --quiet "$remote" || { say "offline  $name (fetch failed)"; return; }
  default=$(git -C "$dir" symbolic-ref --short "refs/remotes/$remote/HEAD" 2>/dev/null | sed "s#^$remote/##")
  [[ -z "$default" ]] && default=$(gh repo view "$ORG/$name" --json defaultBranchRef --jq .defaultBranchRef.name)
  current=$(git -C "$dir" branch --show-current)
  if [[ -n "$(git -C "$dir" status --porcelain)" || "$current" != "$default" ]]; then
    say "fetched  $name (on ${current:-a detached HEAD} or with local changes; not merged)"
  elif git -C "$dir" merge --quiet --ff-only "$remote/$default" >/dev/null 2>&1; then
    say "updated  $name"
  else
    say "diverged $name (left as is)"
  fi
}

cmd_core() {
  need gh git
  mkdir -p "$repos_dir"
  for name in "${CORE[@]}"; do clone_or_update "$name"; done
  say "Core repos are in repos/. Image repos come on demand: ./harness get <name>."
}

cmd_get() {
  need gh git
  (( $# )) || die "usage: ./harness get <repo>..."
  mkdir -p "$repos_dir"
  local name
  for arg in "$@"; do
    name=$(resolve_repo "$arg")
    clone_or_update "$name"
  done
}

cmd_all() {
  need gh git
  mkdir -p "$repos_dir"
  say "Cloning every repo in $ORG (about 230, a few GB with dev environments). Ctrl-C to stop; re-run to resume."
  gh repo list "$ORG" --limit 1000 --no-archived --json name --jq '.[].name' | sort | while read -r name; do
    clone_or_update "$name"
  done
}

cmd_sync() {
  need gh git
  [[ -d "$repos_dir" ]] || die "nothing cloned yet: ./harness core"
  local live
  live=$(gh repo list "$ORG" --limit 1000 --json name,isArchived --jq '.[] | "\(.name) \(.isArchived)"')
  for dir in "$repos_dir"/*/; do
    local name
    name=$(basename "$dir")
    [[ "$name" == "dot-github" ]] && name=.github
    if [[ ! -e "$dir/.git" ]]; then
      say "stale    $(basename "$dir") (not a git clone; safe to delete if you made it by hand)"
    elif ! grep -q "^$name " <<<"$live"; then
      say "gone     $name (no longer in $ORG; delete repos/$(basename "$dir") when you are done with it)"
    elif grep -q "^$name true$" <<<"$live"; then
      say "archived $name"
    else
      clone_or_update "$name"
    fi
  done
}

cmd_fork() {
  need gh git
  (( $# == 1 )) || die "usage: ./harness fork <repo>"
  local name dir
  name=$(resolve_repo "$1")
  dir=$(repo_dir "$name")
  [[ -e "$dir/.git" ]] || clone_or_update "$name"
  if git -C "$dir" remote get-url upstream >/dev/null 2>&1; then
    say "$name is already forked: origin $(git -C "$dir" remote get-url origin), upstream $(git -C "$dir" remote get-url upstream)"
    return
  fi
  (cd "$dir" && gh repo fork --remote --remote-name origin >/dev/null)
  say "forked $name: origin is now your fork ($(git -C "$dir" remote get-url origin)), upstream is $ORG/$name."
  say "Push branches to origin; open the pull request against upstream."
}

cmd_setup() {
  (( $# == 1 )) || die "usage: ./harness setup <repo>"
  local name dir python=python3
  name=$(resolve_repo "$1")
  dir=$(repo_dir "$name")
  [[ -d "$dir" ]] || clone_or_update "$name"
  have python3.13 && python=python3.13
  if [[ " ${PYTHON_REPOS[*]} " == *" $name "* ]]; then
    [[ -d "$dir/.venv" ]] || "$python" -m venv "$dir/.venv"
    # The other Python repos install builder from builder@main; a local builder clone wins when there is one.
    "$dir/.venv/bin/pip" install --quiet --upgrade pip
    if [[ "$name" != builder && -d "$repos_dir/builder" ]]; then
      "$dir/.venv/bin/pip" install --quiet -e "$repos_dir/builder"
    fi
    "$dir/.venv/bin/pip" install --quiet -e "${dir}[dev]"
    say "$name: .venv ready ($("$dir/.venv/bin/python" --version))"
  elif [[ "$name" == site ]]; then
    need node npm
    (cd "$dir" && npm ci --silent && npx --yes playwright install chromium >/dev/null)
    say "site: node_modules and Chromium ready"
  elif [[ "$name" == dumper ]]; then
    need cargo
    (cd "$dir" && cargo build --quiet)
    say "dumper: built"
  else
    say "$name needs no dev environment: image repos and mods are checked with Docker (./harness validate $name)."
  fi
}

# ---------------------------------------------------------------------------------------------------- data

cmd_control() {
  need curl
  [[ $# -eq 1 ]] || die "usage: ./harness control <path>, e.g. api/queue.json"
  control_fetch "$1"
}

cmd_snapshot() {
  need curl jq
  local stamp dir
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  dir=$state/snapshot/$stamp
  mkdir -p "$dir"
  for endpoint in status fleet runs queue pulls issues skips batch; do
    control_fetch "api/$endpoint.json" >"$dir/control-$endpoint.json" || warn "control /api/$endpoint.json failed"
  done
  fetch "$HUB/api/v1/status.json" >"$dir/hub-status.json" || warn "hub status failed"
  fetch "$HUB/api/v1/fleet/staleness.json" >"$dir/hub-staleness.json" || warn "hub staleness failed"
  if have gh && gh auth status >/dev/null 2>&1; then
    gh search prs --owner "$ORG" --state open --limit 200 \
      --json number,title,repository,author,createdAt,updatedAt,labels,isDraft,url,commentsCount >"$dir/gh-prs.json" ||
      warn "gh search prs failed"
    gh search issues --owner "$ORG" --state open --limit 200 \
      --json number,title,repository,author,createdAt,updatedAt,labels,url,commentsCount >"$dir/gh-issues.json" ||
      warn "gh search issues failed"
  fi
  ln -sfn "$stamp" "$state/snapshot/latest"
  say "snapshot $stamp in .harness/snapshot/latest/"
  [[ -s "$dir/control-fleet.json" ]] && jq -r '
    "fleet:   \(.rows | length) live branches, \([.rows[] | select(.result == "failure")] | length) red (\([.rows[] | select(.result == "failure" and (.skip | length) > 0)] | length) of them skip-flagged), \([.rows[] | . as $r | select($r.drift == "ahead" and $r.source != "os" and (($r.released // "") | contains($r.upstream // "~") | not))] | length) behind upstream (\([.rows[] | select(.drift == "ahead")] | length) rows say ahead; os bases and tags that embed the upstream value are discounted), \([.rows[] | select((.skip | length) > 0)] | length) with skip flags"' \
    "$dir/control-fleet.json"
  [[ -s "$dir/control-fleet.json" ]] && jq -r '.helpers[] | select((.failing | length) > 0) | "helpers: \(.name) has \(.failing | length) failing branches (\(.failing | join(", ")))"' "$dir/control-fleet.json"
  [[ -s "$dir/control-queue.json" ]] && jq -r '"runners: \(.in_use)/\(.limit) jobs in use, \(.queued | length) queued"' "$dir/control-queue.json"
  [[ -s "$dir/control-pulls.json" ]] && jq -r '"pulls:   \(.pulls | length) open (\([.pulls[] | select(.pull.title | startswith("[test data]"))] | length) of them [test data] fixtures, \([.pulls[] | select(.pull.title | startswith("Reference PR"))] | length) the reference PR)"' "$dir/control-pulls.json"
  [[ -s "$dir/control-issues.json" ]] && jq -r '"issues:  \(.issues | length) open (\([.issues[] | select(.title | startswith("[test data]"))] | length) of them [test data] fixtures)"' "$dir/control-issues.json"
  [[ -s "$dir/hub-status.json" ]] && jq -r '.data.status // .data | "hub:     \(.health // "?"), \(.images // "?") images; stale sources: \([.sources // {} | to_entries[] | select(.value.ok | not) | .key] | join(", ") | if . == "" then "none" else . end)"' "$dir/hub-status.json"
  return 0
}

cmd_lookup() {
  need curl jq
  (( $# == 1 )) || die "usage: ./harness lookup <image>"
  local name tmp
  name=$(image_name "$1")
  tmp=$state/lookup/$name
  mkdir -p "$tmp"
  fetch "$HUB/api/v1/catalog/$name.json" >"$tmp/catalog.json" 2>/dev/null || die "the hub has no image '$name': lookup is for images (check $HUB/api/v1/images.json); for an infrastructure repo use gh and the snapshot"
  fetch "$HUB/api/v1/catalog/$name/builds.json" >"$tmp/builds.json" || echo '{"data":{"builds":[]}}' >"$tmp/builds.json"
  control_fetch "api/images/$name.json" >"$tmp/control.json" || echo '{}' >"$tmp/control.json"
  fetch "$HUB/api/v1/fleet/bases.json" >"$tmp/bases.json" || echo '{"data":{"bases":[]}}' >"$tmp/bases.json"
  jq -r --arg site "$SITE" '.data.image |
    "\(.name) (\(.kind // "app"))\(if .deprecated then " DEPRECATED" else "" end)\(if .archived then " ARCHIVED" else "" end): \(.description // "" | .[0:160])",
    "  page:     \($site)/images/\(.name)/",
    "  repo:     \(.github_url)",
    "  upstream: \(.project_url // "?") at \(.upstream_version // "?"); base \(.base // "?"); arches \(.architectures // [] | map(.arch? // .) | join(", "))",
    "  tags:     \(.tags // [] | map(.tag) | join(", "))"' "$tmp/catalog.json"
  say "  live branches (control):"
  # version_tag is the tag the last run published, or would have published when it failed; released is what users pull.
  jq -r '.rows // [] | .[] | "    \(.branch): \(.result // "never built")\(if .result == "failure" then " (reason \(.reason // "?"), would have published \(.version_tag // "?"), https://github.com/\(.repo)/actions/runs/\(.run_id))" else " \(.version_tag // "") (reason \(.reason // "?"))" end); released \(.released // "nothing")\(if .drift == "ahead" then " (upstream moved to \(.upstream); check it by eye: os bases and a branch released minutes ago show ahead wrongly)" else "" end)\(if (.skip | length) > 0 then " skip: \(.skip | join(","))" else "" end), last run ended \(.built_at // "?"), next check \(.next_check // "?")"' "$tmp/control.json"
  # The newest scheduler decision per branch and kind says why nothing was dispatched (cooldown, assets not ready,
  # a skip flag, "os image: builds on the package check") or that a build went out.
  control_fetch "api/scheduler.json?image=$name" >"$tmp/scheduler.json" || echo '{"decisions":[]}' >"$tmp/scheduler.json"
  say "  scheduler (newest decision per branch and check):"
  jq -r '[.decisions[] | .decision + {reason: (.info.reason // "")}] | group_by([.branch, .kind]) | map(max_by(.at)) | sort_by(.branch, .kind)[]
    | "    \(.branch) \(.kind): \(.outcome)\(if .reason != "" then " (\(.reason))" else "" end) at \(.at[:16])"' "$tmp/scheduler.json"
  # The newest dispatch per branch is the build control last asked for; a workflow_dispatch by a person shows in
  # neither list (gh api repos/<org>/<repo>/actions/runs/<id> --jq .triggering_actor.login names them).
  control_fetch "api/scheduler.json?image=$name&outcome=dispatch" >"$tmp/dispatches.json" || echo '{"decisions":[]}' >"$tmp/dispatches.json"
  jq -r '[.decisions[] | .decision + {reason: (.info.reason // ""), as: (.info.dispatch_reason // "")}] | group_by(.branch) | map(max_by(.at))[]
    | "    \(.branch) last dispatch by control: \(.kind) check → \(.as) build (\(.reason)) at \(.at[:16])"' "$tmp/dispatches.json"
  say "  recent releases (hub; a record newer than its Release by an hour or more is a republish of the same tag):"
  jq -r --arg site "$SITE" --arg name "$name" --slurpfile control "$tmp/control.json" '
    ($control[0].releases // [] | map({(.tag): .published_at}) | add // {}) as $published
    | .data.builds[:5][] | "    \(.tag) \(.branch) record \(.created)\(if $published[.tag] then " release \($published[.tag])" + (if ((.created | sub("\\+00:00$"; "Z") | fromdateiso8601) - ($published[.tag] | sub("\\+00:00$"; "Z") | fromdateiso8601)) > 3600 then " REPUBLISHED" else "" end) else "" end) tests \(if .test_success then "passed" else "FAILED" end) \(.platforms | map("\(.arch)=\(.result)") | join(" "))  \($site)/images/\($name)/builds/\(.tag)/"' "$tmp/builds.json"
  # Why the newest release exists: the build page's "Why this built" panel comes from the same diff. Control lists
  # every run that published the tag, so a republished tag shows the run that minted it and each republish.
  local newest
  newest=$(jq -r '.data.builds[0].tag // ""' "$tmp/builds.json")
  if [[ -n "$newest" ]]; then
    jq -r --arg tag "$newest" '[.builds // [] | .[] | select(.version_tag == $tag and .result == "success")] | sort_by(.published_at)
      | if length == 0 then empty else "  runs that published \($tag): \(length) (the first minted it, the rest republished it)", (.[] | "    \(.published_at[:16]) reason \(.reason) \(.run_url)") end' "$tmp/control.json"
  fi
  if [[ -n "$newest" ]] && fetch "$HUB/api/v1/catalog/$name/builds/$newest/diff.json" >"$tmp/diff.json" 2>/dev/null; then
    jq -r '.data.diff | "  why the newest record of \(.tag) exists: trigger \(.trigger // "not recorded (record made before 2026-10-31)"); \(.reasons // [] | join("; "))\(if (.commit.commits // []) | length > 0 then "; commits: " + ((.commit.commits | map("\(.sha[:7]) \(.subject)\(if .bot then " (bot)" else "" end)")) | join(", ")) else "" end)"' "$tmp/diff.json"
  fi
  control_fetch "api/pulls.json" >"$tmp/pulls.json" || echo '{"pulls":[]}' >"$tmp/pulls.json"
  control_fetch "api/issues.json" >"$tmp/issues.json" || echo '{"issues":[]}' >"$tmp/issues.json"
  jq -r --arg repo "$ORG/docker-$name" '[.pulls[] | select(.pull.repo == $repo)] |
    "  open PRs: \(length)", (.[] | "    #\(.pull.number) \(.pull.title) (build \(.run.conclusion // .run.status // "none"), review \(.pull.review_state // "none"))\(if (.pull.title | startswith("Reference PR")) then "  [the reference PR: not work, leave it out of rankings]" else "" end)")' "$tmp/pulls.json"
  jq -r --arg repo "$ORG/docker-$name" '[.issues[] | select(.repo == $repo)] |
    "  open issues: \(length)", (.[] | "    #\(.number) \(.title) [\(.labels | join(", "))]")' "$tmp/issues.json"
  # Dependents per tag, from the hub's base graph (the final FROM of each build; a multi-stage build whose base is
  # only a build stage shows as scratch, so the Dockerfiles are the last word).
  jq -r --arg name "$name" '[.data.bases[] | select(.image | test("/" + $name + ":"))] | group_by(.image) | map({image: .[0].image, images: ([.[].images[]] | unique)}) | sort_by(.image)[]
    | "  built FROM \(.image | sub("^ghcr.io/"; ""))\(if (.image | test("/linuxserver/")) then " (the linuxserver base: these builds are not on the playground base yet)" else "" end): \(.images | length) images: \(.images | join(", "))"' "$tmp/bases.json"
  return 0
}

cmd_data() {
  need gh git
  local hub
  hub=$(repo_dir hub)
  [[ -e "$hub/.git" ]] || clone_or_update hub
  [[ -x "$hub/scripts/data.sh" ]] || die "repos/hub has no scripts/data.sh: ./harness sync, then try again"
  "$hub/scripts/data.sh"
  say "The hub's whole dataset is in repos/hub/data/, a depth-1 checkout of its data branch (CI owns it: never edit or push it)."
  say "  images/<name>/manifest.<branch>.json        image.yml of every live branch, as the hub read it"
  say "  images/<name>/latest.json, history.json      newest tag per branch; every release seen, with its run"
  say "  images/<name>/builds/<tag>.json              build.json; beside it .diff.json, .test.<arch>.json, .layers.<arch>.json, .vulns.json"
  say "  images/<name>/packages[.<tag>].<arch>.json   the package table of each branch's newest build"
  say "  mods.json, proot-apps.json, observed.json (stars), bases/, status/   (repos/hub/README.md describes every file)"
  say "Answer fleet-wide questions with jq over these files, not with hundreds of Pages requests. Re-run for fresh data."
}

# ---------------------------------------------------------------------------------------------------- docker

cmd_try() {
  need docker jq curl
  # --env KEY=VALUE (repeatable) anywhere on the line adds variables to the container: DOCKER_MODS and the mod's
  # own settings, or an image option under test. The rest of the arguments keep their meaning.
  local extra_env=() rest=()
  while (( $# )); do
    case "$1" in
      --env | -e) [[ "${2:-}" == *=* ]] || die "--env takes KEY=VALUE"; extra_env+=(-e "$2"); shift 2 ;;
      --env=*) extra_env+=(-e "${1#--env=}"); shift ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  set -- "${rest[@]}"
  if (( $# == 0 )) || [[ "$1" == "-h" || "$1" == "--help" ]]; then
    die "usage: ./harness try <image> [tag] | --build <repo> | --stop [image] [--env KEY=VALUE]..."
  fi
  if [[ "$1" == "--stop" ]]; then
    local filter=harness-try-
    [[ -n "${2:-}" ]] && filter=harness-try-$(image_name "$2")
    # -v: a labs try keeps /config in an anonymous volume; a bind mount's data (try's .harness/try/) stays.
    docker ps -aq --filter "name=$filter" | xargs -r docker rm -fv >/dev/null
    say "stopped ${2:-every harness-try container}"
    return
  fi
  local name ref
  if [[ "$1" == "--build" ]]; then
    local repo dir dockerfile=Dockerfile
    repo=$(resolve_repo "${2:?usage: ./harness try --build <repo>}")
    dir=$(repo_dir "$repo")
    name=$(image_name "$repo")
    [[ "$(uname -m)" == "aarch64" || "$(uname -m)" == "arm64" ]] && dockerfile=Dockerfile.aarch64
    ref=harness-local/$name:$(git -C "$dir" rev-parse --short HEAD)
    say "building $ref from $repo ($dockerfile, --pull --no-cache, as CI does)"
    docker build --pull --no-cache -f "$dir/$dockerfile" -t "$ref" "$dir"
  else
    name=$(image_name "$1")
    local tag=${2:-latest}
    if [[ "$tag" == */* || "$tag" == *:* ]]; then ref=$tag; else ref=$REGISTRY/$name:$tag; fi
    docker pull --quiet "$ref" >/dev/null || die "cannot pull $ref"
  fi
  local catalog args=(-d --name "harness-try-$name" -e PUID="$(id -u)" -e PGID="$(id -g)" -e TZ=Etc/UTC)
  (( ${#extra_env[@]} )) && args+=("${extra_env[@]}")
  catalog=$(fetch "$HUB/api/v1/catalog/$name.json" 2>/dev/null || echo '{}')
  local data=$state/try/$name
  mkdir -p "$data"
  while IFS=$'\t' read -r kind a b; do
    case "$kind" in
      port)
        local host=$a
        # Avoid privileged and busy host ports: shift into 18000+ when needed.
        if (( host < 1024 )) || (ss -ltn 2>/dev/null | grep -q ":$host "); then host=$((18000 + a % 1000)); fi
        args+=(-p "$host:$b")
        say "  port  http://localhost:$host -> $b"
        ;;
      volume)
        mkdir -p "$data/${a//\//_}"
        args+=(-v "$data/${a//\//_}:$a")
        ;;
      env) args+=(-e "$a=$b") ;;
    esac
  done < <(jq -r '.data.image.config // {} |
    (.ports // [] | map(select(.optional | not))[] | "port\t\(.internal | split("/")[0])\t\(.internal)"),
    (.volumes // [] | map(select(.optional | not))[] | "volume\t\(.path)\t"),
    (.env_vars // [] | map(select((.optional | not) and (.name | IN("PUID","PGID","TZ") | not)))[] | "env\t\(.name)\t\(.value)")' <<<"$catalog")
  docker rm -f "harness-try-$name" >/dev/null 2>&1 || true
  docker run "${args[@]}" "$ref" >/dev/null
  say "started harness-try-$name from $ref (data in .harness/try/$name/); waiting for init"
  wait_for_init "harness-try-$name" 300
  say "init done after ~${init_waited}s. Last log lines:"
  docker logs --tail 15 "harness-try-$name" 2>&1
  say "Stop it with ./harness try --stop $name"
}

# Wait for s6's '[ls.io-init] done.' in a container's log; sets init_waited. Dies, with the log tail, when the
# container exits first or the timeout passes.
init_waited=0
wait_for_init() {
  local container=$1 timeout=${2:-300}
  init_waited=0
  until docker logs "$container" 2>&1 | grep -q '\[ls.io-init\] done\.'; do
    if [[ "$(docker inspect -f '{{.State.Running}}' "$container")" != true ]]; then
      docker logs --tail 40 "$container" 2>&1
      die "the container exited before init finished"
    fi
    (( init_waited >= timeout )) && { docker logs --tail 40 "$container" 2>&1; die "no '[ls.io-init] done.' after ${timeout}s"; }
    sleep 5
    init_waited=$((init_waited + 5))
  done
}

builder() {
  local dir=$1
  shift
  docker run --rm -v "$dir":/repo --user "$(id -u):$(id -g)" "$BUILDER_IMAGE" "$@"
}

cmd_render() {
  need docker git
  (( $# >= 1 )) || die "usage: ./harness render <repo> [--in-place]"
  local repo dir in_place=false
  repo=$(resolve_repo "$1")
  [[ "${2:-}" == "--in-place" ]] && in_place=true
  dir=$(repo_dir "$repo")
  [[ -f "$dir/image.yml" || -f "$dir/mod.yml" ]] || die "$repo has no image.yml or mod.yml on the checked-out branch"
  docker pull --quiet "$BUILDER_IMAGE" >/dev/null
  if [[ -f "$dir/mod.yml" ]]; then
    if builder "$dir" render-mod --check; then say "mod files are up to date"; else say "generated files differ: ./harness render <checkout> --in-place rewrites them (on mod branches they are committed with the change)"; fi
    $in_place && builder "$dir" render-mod
    return 0
  fi
  local rc=0
  builder "$dir" check --drift warn || rc=$?
  if $in_place; then
    builder "$dir" render
    say "Rendered in place. Commit these only on a new repo's first pull request or a live branch; on any other PR branch the build fails when generated files change."
  else
    local out=$state/render/$repo
    rm -rf "$out"
    mkdir -p "$out"
    git -C "$dir" ls-files -z | (cd "$dir" && xargs -0 cp --parents -t "$out" 2>/dev/null) || true
    builder "$out" render --all
    say "Rendered out of tree in .harness/render/$repo/ (README.md, AGENTS.md, LICENSE, .github/FUNDING.yml, root/donate.txt, the workflows; docs page in .builder-out/)."
    for file in "${GENERATED[@]}"; do
      [[ -f "$out/$file" ]] || continue
      if ! diff -q "$dir/$file" "$out/$file" >/dev/null 2>&1; then say "  differs from the checkout: $file"; fi
    done
  fi
  return "$rc"
}

# ---------------------------------------------------------------------------------------------------- validate

cmd_validate() {
  (( $# >= 1 )) || die "usage: ./harness validate <repo> [--no-build]"
  local repo dir build=true
  repo=$(resolve_repo "$1")
  [[ "${2:-}" == "--no-build" ]] && build=false
  dir=$(repo_dir "$repo")
  [[ -e "$dir/.git" ]] || die "$repo is not cloned: ./harness get $repo"
  mkdir -p "$state/validation"
  local report=$state/validation/$repo.md failed=0
  {
    say "# Validation of $repo"
    say ""
    say "Branch \`$(git -C "$dir" branch --show-current)\` at \`$(git -C "$dir" rev-parse --short HEAD)\`, $(date -u +%Y-%m-%dT%H:%M:%SZ), harness $VERSION."
    say ""
  } >"$report"
  step() {
    local label=$1
    shift
    say "== $label"
    if (cd "$dir" && "$@") >"$state/validation/step.log" 2>&1; then
      say "- $label: ok" >>"$report"
      tail -n 3 "$state/validation/step.log"
    else
      say "- $label: FAILED" >>"$report"
      tail -n 30 "$state/validation/step.log"
      failed=$((failed + 1))
    fi
  }
  skip() { say "- $1: not run ($2)" >>"$report"; say "== $1: not run ($2)"; }

  if [[ -f "$dir/image.yml" ]]; then
    validate_image "$dir"
  elif [[ -f "$dir/mod.yml" ]]; then
    validate_mod "$dir"
  else
    case "$repo" in
      builder | hub | control | ci)
        [[ -x "$dir/.venv/bin/python" ]] || die "no .venv in $repo: ./harness setup $repo"
        local mypy_args=()
        [[ "$repo" == control ]] && mypy_args=(control tests)
        [[ "$repo" == ci ]] && mypy_args=(ci tests)
        step "ruff check" "$dir/.venv/bin/ruff" check .
        step "ruff format --check" "$dir/.venv/bin/ruff" format --check .
        step "mypy" "$dir/.venv/bin/mypy" "${mypy_args[@]}"
        step "pytest" "$dir/.venv/bin/pytest" -q
        if [[ "$repo" == builder ]]; then
          step "contracts examples" bash -c '.venv/bin/python -m contracts image examples/*/image.yml'
        elif [[ "$repo" == hub ]]; then
          step "data/ from the data branch" scripts/data.sh
          step "build the API" "$dir/.venv/bin/python" -m lsio_hub.build
          step "generate --offline" "$dir/.venv/bin/python" -m lsio_hub.generate --offline
        fi
        ;;
      workflows)
        [[ -x "$dir/.venv/bin/python" ]] || die "no .venv in workflows: ./harness setup workflows"
        if have shellcheck; then
          step "scripts/check.sh" ./scripts/check.sh
        else
          # check.sh calls shellcheck from PATH; give it the container, as doctor promises.
          mkdir -p "$state/bin"
          # shellcheck disable=SC2016
          printf '#!/usr/bin/env bash\nexec docker run --rm -v "$PWD":/mnt -w /mnt %s "$@"\n' "$SHELLCHECK_IMAGE" >"$state/bin/shellcheck"
          chmod +x "$state/bin/shellcheck"
          step "scripts/check.sh (shellcheck from $SHELLCHECK_IMAGE)" env PATH="$state/bin:$PATH" ./scripts/check.sh
        fi
        ;;
      site)
        [[ -d "$dir/node_modules" ]] || die "no node_modules in site: ./harness setup site"
        step "snapshots from the data branch" npm run snapshot
        step "npm run check" npm run check
        step "npm run build" npm run build
        if have npx; then
          # The preview server's command line is node .../astro.mjs preview, so a pkill on "astro preview" never finds
          # it: keep its pid and kill that.
          local preview_pid
          (cd "$dir" && exec npx astro preview --port 4321 >/dev/null 2>&1) &
          preview_pid=$!
          sleep 4
          step "a11y" node scripts/a11y.mjs http://localhost:4321/site
          step "search" node scripts/test-search.mjs http://localhost:4321/site
          step "overflow at 390px (home)" node scripts/overflow.mjs http://localhost:4321/site/
          pkill -P "$preview_pid" 2>/dev/null || true
          kill "$preview_pid" 2>/dev/null || true
        fi
        say "- also run, when the change touches them: overflow.mjs on every changed page, editor-check.mjs (editor), fleet-check.mjs (fleet pages)" >>"$report"
        ;;
      dumper)
        step "cargo test" cargo test --quiet
        step "cargo clippy" cargo clippy --quiet -- -D warnings
        ;;
      *)
        if [[ -f "$dir/AGENTS.md" ]]; then
          say "- $repo has no harness recipe: follow the validation list in its AGENTS.md" >>"$report"
        fi
        ;;
    esac
  fi
  say ""
  say "Report: .harness/validation/$repo.md"
  cat "$report"
  (( failed == 0 ))
}

validate_image() {
  local dir=$1 base remote=origin branch live
  # In a fork the org's branches are on upstream; the pull request will target the branch image.yml names.
  git -C "$dir" remote get-url upstream >/dev/null 2>&1 && remote=upstream
  branch=$(git -C "$dir" branch --show-current)
  live=$(awk '/^release:/ { r = 1; next } /^[^ ]/ { r = 0 } r && /^  branch:/ { gsub(/["'\'']/, "", $2); print $2; exit }' "$dir/image.yml")
  base=${HARNESS_BASE:-}
  if [[ -z "$base" && -n "$live" && "$branch" != "$live" ]]; then
    base=$(git -C "$dir" merge-base HEAD "$remote/$live" 2>/dev/null || true)
  fi

  if have docker && docker info >/dev/null 2>&1; then
    docker pull --quiet "$BUILDER_IMAGE" >/dev/null
    step "builder check --drift warn" docker run --rm -v "$dir":/repo --user "$(id -u):$(id -g)" "$BUILDER_IMAGE" check --drift warn
  else
    skip "builder check" "Docker is not available"
  fi
  if [[ -n "$base" ]]; then
    local edited
    edited=$(git -C "$dir" diff --name-only "$base" HEAD -- "${GENERATED[@]}")
    if [[ -n "$edited" ]] && git -C "$dir" cat-file -e "$base:image.yml" 2>/dev/null; then
      say "- generated files untouched: FAILED ($(echo "$edited" | paste -sd, -) changed; the PR build refuses this)" >>"$report"
      say "== generated files: FAILED, $(echo "$edited" | paste -sd, -) changed against $base"
      failed=$((failed + 1))
    else
      say "- generated files untouched: ok" >>"$report"
    fi
    if git -C "$dir" diff --name-only "$base" HEAD | grep -qE '^(Dockerfile|root/)'; then
      if git -C "$dir" diff "$base" HEAD -- image.yml | grep -qE '^\+.*date:'; then
        say "- changelog entry for the Dockerfile/root change: ok" >>"$report"
      else
        say "- changelog entry for the Dockerfile/root change: MISSING (add one at the top of changelog: in image.yml)" >>"$report"
        say "== changelog: no new entry in image.yml for a Dockerfile or root/ change"
        failed=$((failed + 1))
      fi
    fi
    if git -C "$dir" diff --name-only "$base" HEAD | grep -qx 'Dockerfile' && ! git -C "$dir" diff --name-only "$base" HEAD | grep -qx 'Dockerfile.aarch64'; then
      say "- both Dockerfiles changed: WARN (Dockerfile changed, Dockerfile.aarch64 did not; they must agree apart from FROM)" >>"$report"
    fi
  else
    skip "generated files and changelog" "on the live branch itself, nothing to compare against"
  fi
  local scripts=()
  if [[ -d "$dir/root" ]]; then
    while IFS= read -r -d '' file; do
      head -n1 "$file" | grep -qE '^#!.*(bash|sh)' && scripts+=("${file#"$dir"/}")
    done < <(find "$dir/root" -type f -print0)
  fi
  if (( ${#scripts[@]} )); then
    if have shellcheck; then
      step "shellcheck root/" shellcheck -s bash -x "${scripts[@]}"
    elif have docker; then
      step "shellcheck root/ (container)" docker run --rm -v "$dir":/mnt -w /mnt "$SHELLCHECK_IMAGE" -s bash "${scripts[@]}"
    else
      skip "shellcheck" "neither shellcheck nor Docker"
    fi
    local noexec
    noexec=$(cd "$dir" && find root -path '*/s6-overlay/s6-rc.d/*' \( -name run -o -name finish -o -name check -o -name up \) -type f ! -perm -u+x 2>/dev/null | grep -v '/up$' || true)
    if [[ -n "$noexec" ]]; then
      say "- s6 scripts executable: FAILED ($noexec)" >>"$report"
      failed=$((failed + 1))
    else
      say "- s6 scripts executable: ok" >>"$report"
    fi
  fi
  if $build && have docker && docker info >/dev/null 2>&1; then
    local arch dockerfile=Dockerfile name
    name=$(image_name "$(basename "$dir")")
    arch=amd64
    [[ "$(uname -m)" == "aarch64" || "$(uname -m)" == "arm64" ]] && { arch=arm64; dockerfile=Dockerfile.aarch64; }
    step "docker build ($arch)" docker build --pull --no-cache -f "$dockerfile" -t "harness-local/$name:validate" .
    local other=arm64 other_file=Dockerfile.aarch64 qemu=qemu-aarch64
    [[ "$arch" == arm64 ]] && { other=amd64; other_file=Dockerfile; qemu="qemu-x86_64"; }
    if [[ -e /proc/sys/fs/binfmt_misc/$qemu && -f "$dir/$other_file" ]]; then
      step "docker build ($other, emulated)" docker buildx build --load --pull --no-cache --platform "linux/$other" -f "$other_file" -t "harness-local/$name:validate-$other" .
    else
      skip "docker build ($other)" "no emulation for $other here; the PR build covers it"
    fi
    say "- run it: ./harness try --build $(basename "$dir") (waits for [ls.io-init] done.)" >>"$report"
  else
    skip "docker build" "$($build && echo "Docker is not available" || echo "--no-build")"
  fi
}

validate_mod() {
  local dir=$1 mods=$repos_dir/docker-mods
  if have docker && docker info >/dev/null 2>&1; then
    docker pull --quiet "$BUILDER_IMAGE" >/dev/null
    step "builder render-mod --check" docker run --rm -v "$dir":/repo --user "$(id -u):$(id -g)" "$BUILDER_IMAGE" render-mod --check
  else
    skip "render-mod --check" "Docker is not available"
  fi
  if [[ -x "$mods/tools/check-branch.sh" && "$dir" != "$mods" ]]; then
    local python=python3
    [[ -x "$repos_dir/builder/.venv/bin/python" ]] && python=$repos_dir/builder/.venv/bin/python
    step "tools/check-branch.sh" env PYTHON="$python" "$mods/tools/check-branch.sh" "$dir"
    $build && step "tools/test-mod.sh" "$mods/tools/test-mod.sh" "$dir"
  else
    skip "check-branch.sh and test-mod.sh" "work on the mod branch in its own worktree: git -C repos/docker-mods worktree add ../docker-mods-<branch> <branch>"
  fi
}

# ---------------------------------------------------------------------------------------------------- drafts

cmd_draft() {
  local kind=${1:-} repo dir out login role
  [[ "$kind" =~ ^(pr|issue|request|review|proposal)$ ]] || die "usage: ./harness draft pr|issue|request|review|proposal <repo-or-name> [number]"
  login=$(jq -r '.login // ""' "$profile" 2>/dev/null || echo "")
  role=$(role)
  mkdir -p "$state/drafts"
  if [[ "$kind" == proposal ]]; then
    # A new image proposal for Labs: the fields of the proposal form in $LABS_PROPOSALS, in the "### <label>"
    # layout GitHub gives a form submission, so the check workflow and ./harness labs read a draft the same way.
    local name=${2:?usage: ./harness draft proposal <name>}
    name=$(image_name "$name")
    out=$state/drafts/proposal-$name.md
    sed -e "s|{{name}}|$name|g" -e "s|{{login}}|$login|g" -e "s|{{version}}|$VERSION|g" "$here/templates/proposal-image.md" >"$out"
    say "draft: ${out#"$here"/}"
    say "Fill every TODO, then ./harness labs form $name turns it into a prefilled link to the proposal form (the way to file it)."
    return
  fi
  repo=$(resolve_repo "${2:?usage: ./harness draft $kind <repo>}")
  dir=$(repo_dir "$repo")
  case "$kind" in
    pr)
      [[ -e "$dir/.git" ]] || die "$repo is not cloned"
      local branch base fork=false head
      branch=$(git -C "$dir" branch --show-current)
      git -C "$dir" remote get-url upstream >/dev/null 2>&1 && fork=true
      base=${3:-$(gh repo view "$ORG/$repo" --json defaultBranchRef --jq .defaultBranchRef.name)}
      head=$branch
      $fork && head=$login:$branch
      if ! $fork && [[ "$(role)" == contributor ]]; then
        warn "no fork yet: a contributor's PR head must be <login>:<branch> on their fork. Run ./harness fork $repo, push the branch there, then draft again."
      fi
      out=$state/drafts/pr-$repo-${branch//\//-}.md
      local diffstat validation
      diffstat=$(git -C "$dir" diff --stat "$($fork && echo upstream || echo origin)/$base...HEAD" 2>/dev/null | tail -n 20 || true)
      [[ "$branch" == "$base" ]] && warn "you are on $base itself: make a topic branch (git switch -c <topic>) before drafting a PR"
      validation="  - not run"
      if [[ -f "$state/validation/$repo.md" ]]; then
        if grep -q "at \`$(git -C "$dir" rev-parse --short HEAD)\`" "$state/validation/$repo.md"; then
          validation=$(sed -n 's/^- /  - /p' "$state/validation/$repo.md")
        else
          warn "the validation report is for another commit: run ./harness validate $repo again"
          validation="  - stale: re-run ./harness validate $repo"
        fi
      fi
      sed -e "s|{{repo}}|$repo|g" -e "s|{{role}}|$role|g" -e "s|{{version}}|$VERSION|g" \
        "$here/templates/pr-body.md" >"$out"
      {
        say ""
        say "<!-- harness-fill: replace the TODOs above; this block is for you, delete it before filing"
        say "branch: $branch -> $base"
        say "validation (from .harness/validation/$repo.md):"
        say "$validation"
        say "diff:"
        say "$diffstat"
        say "file it with:"
        say "  gh pr create -R $ORG/$repo --base $base --head $head --title \"<short imperative sentence>\" --body-file $out"
        say "-->"
      } >>"$out"
      ;;
    issue)
      out=$state/drafts/issue-$repo-$(date +%Y%m%d%H%M%S).md
      sed -e "s|{{repo}}|$repo|g" -e "s|{{role}}|$role|g" -e "s|{{version}}|$VERSION|g" "$here/templates/issue.md" >"$out"
      say "<!-- file it with: gh issue create -R $ORG/$repo --title \"<what is wrong, in a sentence>\" --body-file $out -->" >>"$out"
      ;;
    request)
      # Not a bug: a feature, a blog topic, a removal, anything a contributor asks a member to do.
      out=$state/drafts/request-$repo-$(date +%Y%m%d%H%M%S).md
      sed -e "s|{{repo}}|$repo|g" -e "s|{{role}}|$role|g" -e "s|{{version}}|$VERSION|g" "$here/templates/request.md" >"$out"
      say "<!-- file it with: gh issue create -R $ORG/$repo --title \"<what you are asking for, in a sentence>\" --body-file $out -->" >>"$out"
      ;;
    review)
      local number=${3:?usage: ./harness draft review <repo> <number>}
      out=$state/drafts/review-$repo-$number.md
      sed -e "s|{{repo}}|$repo|g" -e "s|{{number}}|$number|g" -e "s|{{version}}|$VERSION|g" "$here/templates/review.md" >"$out"
      say "<!-- post it with: gh pr review $number -R $ORG/$repo --comment --body-file $out (or --approve / --request-changes) -->" >>"$out"
      ;;
  esac
  say "draft: ${out#"$here"/}"
}

cmd_allow() {
  need jq
  local action=${1:-} repo=${2:-} minutes=${3:-30}
  [[ "$action" =~ ^(push|force-push|tag|delete)$ && -n "$repo" ]] || die "usage: ./harness allow push|force-push|tag|delete <repo> [minutes]"
  [[ "$(role)" == member ]] || die "only members can grant this; on the contributor path, ask a maintainer in your PR or issue"
  # A Labs repository is named as $LABS_ORG/<repo>; grants are keyed by the repo name, as the guard reads them.
  if [[ "$repo" == "$LABS_ORG/"* ]]; then
    repo=${repo#"$LABS_ORG"/}
  elif [[ "$repo" != "*" ]]; then
    repo=$(resolve_repo "$repo")
  fi
  local file=$state/allow.json until
  until=$(( $(date +%s) + minutes * 60 ))
  [[ -f "$file" ]] || echo '{}' >"$file"
  jq --arg key "$action $repo" --argjson until "$until" \
    'with_entries(select(.value > now)) + {($key): $until}' "$file" >"$file.tmp" && mv "$file.tmp" "$file"
  say "allowed: $action on $repo for $minutes minutes (the guard hook lets it through until then)"
}

# ---------------------------------------------------------------------------------------------------- pages

# GitHub Pages sometimes keeps serving an old deploy of one repository while it reports every new one successful,
# or leaves new deploys syncing until they time out, with its status page green. Deleting the Pages site and
# creating it again clears that. guides/playbooks/fleet-ops.md ("A Pages site that will not publish") says when.
cmd_pages() {
  local sub=${1:-}
  (( $# )) && shift
  case "$sub" in
    check) pages_check "$@" ;;
    reset) pages_reset "$@" ;;
    *) die "usage: ./harness pages check <repo> | ./harness pages reset <repo> [--yes]" ;;
  esac
}

# owner/name for a repo argument: <name>, docker-<name>, or <org>/<name> for the Labs org.
pages_repo() {
  local arg=${1:?repo}
  if [[ "$arg" == */* ]]; then echo "${arg%/}"; else echo "$ORG/$(resolve_repo "$arg")"; fi
}

epoch_of() { date -d "$1" +%s 2>/dev/null || echo 0; }

pages_check() {
  need jq curl
  local full name url served="" served_epoch newest="" newest_epoch verdict
  full=$(pages_repo "${1:-}")
  name=${full#*/}
  url=$(gh api "repos/$full/pages" --jq .html_url 2>/dev/null) || die "$full has no Pages site (gh api repos/$full/pages: 404)"
  say "Pages site: $url (repos/$full/pages: build_type $(gh api "repos/$full/pages" --jq .build_type))"
  served=$(curl -fsSI --max-time 20 -H 'Cache-Control: no-cache' "${url}?harness=$(date +%s)" | tr -d '\r' |
    sed -n 's/^last-modified: //Ip' | head -n1 || true)
  served_epoch=$(epoch_of "$served")
  say "Served deploy: ${served:-unknown} (last-modified of the site root)"
  case "$name" in
    hub | site)
      # Both publish from gh-pages, and a Deploy that built nothing new pushes nothing: compare with that branch.
      local stamp want
      stamp=$(curl -fsS --max-time 20 "${url%/}/deploy.json?harness=$(date +%s)" || true)
      say "Served deploy.json: ${stamp:-unreadable}"
      want=$(gh api "repos/$full/contents/deploy.json?ref=gh-pages" -H 'Accept: application/vnd.github.raw+json' 2>/dev/null || true)
      say "gh-pages deploy.json: ${want:-unreadable}"
      newest=$(gh api "repos/$full/commits/gh-pages" --jq .commit.committer.date 2>/dev/null || true)
      say "gh-pages committed: ${newest:-unknown}"
      ;;
    *)
      newest=$(gh api "repos/$full/releases?per_page=10" --jq '[.[].published_at] | max // empty' || true)
      say "Newest release: ${newest:-none} (the newest releases of every live branch are what its Pages serves)"
      ;;
  esac
  newest_epoch=$(epoch_of "$newest")
  verdict="up to date"
  if (( served_epoch == 0 )); then
    verdict="unknown: the site root answered no last-modified"
  elif (( newest_epoch > served_epoch + 1800 )); then
    verdict="STALE: the site predates its newest deploy by $(( (newest_epoch - served_epoch) / 60 )) minutes"
  fi
  say "Verdict: $verdict"
  say "Control's healing (api/status.json): $(curl -fsS --max-time 20 "$CONTROL/api/status.json" 2>/dev/null |
    jq -c --arg r "$full" '[.healing.pages_retrying[]?, .healing.pages_given_up[]? | select(.repo == $r)]' 2>/dev/null || echo unreadable)"
}

pages_reset() {
  need jq
  local full="" yes=false arg owner role pages build_type cname policy branch path from
  for arg in "$@"; do
    case "$arg" in
      --yes) yes=true ;;
      *) full=$(pages_repo "$arg") ;;
    esac
  done
  [[ -n "$full" ]] || die "usage: ./harness pages reset <repo> [--yes]"
  owner=${full%%/*}
  role=$(gh api "user/memberships/orgs/$owner" --jq 'select(.state == "active") | .role' 2>/dev/null || true)
  [[ "$role" == admin ]] ||
    die "resetting a Pages site needs an owner of $owner (your role there: ${role:-none}). Ask an org owner, with ./harness pages check output"
  pages=$(gh api "repos/$full/pages") || die "$full has no Pages site to reset"
  build_type=$(jq -r .build_type <<<"$pages")
  cname=$(jq -r '.cname // empty' <<<"$pages")
  branch=$(jq -r '.source.branch // empty' <<<"$pages")
  path=$(jq -r '.source.path // "/"' <<<"$pages")
  if [[ "$build_type" == workflow ]]; then
    from="deployed from Actions (build_type workflow)"
  else
    [[ -n "$branch" ]] || die "$full deploys Pages from a branch but names none: reset it by hand in Settings > Pages"
    from="published from the $branch branch, folder $path (build_type legacy)"
  fi
  policy=$(gh api "repos/$full/environments/github-pages" 2>/dev/null | jq -c .deployment_branch_policy || echo null)
  policy=${policy:-null}

  say "Reset of $full's Pages site:"
  say "  1. delete it (gh api -X DELETE repos/$full/pages): $(jq -r .html_url <<<"$pages") answers 404 until step 4 lands"
  say "  2. create it again, $from"
  [[ -n "$cname" ]] && say "     and set its custom domain $cname again: GitHub issues a new certificate, and HTTPS can fail for up to an hour"
  say "  3. keep the github-pages environment's branch rule as it is now: $policy"
  case "${full#*/}" in
    hub | site) say "  4. redeploy: none needed, Pages builds $branch again when the site is created" ;;
    docker-*) say "  4. redeploy: gh workflow run build.yml -R $full -f reason=pages (rebuilds the site from its Releases; builds nothing)" ;;
    *) say "  4. redeploy: not known for this repo; run its Pages workflow yourself" ;;
  esac
  if [[ "$yes" != true ]]; then
    say "Nothing changed. Run it again with --yes once the person has said yes."
    return 0
  fi

  gh api -X DELETE "repos/$full/pages" >/dev/null
  say "deleted"
  local tries=0
  local create=(-f build_type=workflow)
  [[ "$build_type" == workflow ]] || create=(-f build_type=legacy -f "source[branch]=$branch" -f "source[path]=$path")
  until gh api -X POST "repos/$full/pages" "${create[@]}" >/dev/null 2>&1; do
    tries=$((tries + 1))
    (( tries < 6 )) || die "could not create $full's Pages site again: create it in Settings > Pages ($from), then redeploy"
    sleep 5
  done
  say "created again, $from"
  [[ -n "$cname" ]] && gh api -X PUT "repos/$full/pages" -f cname="$cname" >/dev/null && say "custom domain $cname set again"
  if [[ "$policy" == null ]]; then
    gh api -X PUT "repos/$full/environments/github-pages" --input - <<<'{"deployment_branch_policy":null}' >/dev/null
    say "github-pages environment: no branch rule, as before"
  else
    say "github-pages environment now: $(gh api "repos/$full/environments/github-pages" | jq -c .deployment_branch_policy)"
  fi
  case "${full#*/}" in
    hub | site)
      say "Pages builds $branch on its own now: gh api repos/$full/pages/builds/latest, then ./harness pages check $full"
      return 0
      ;;
    docker-*) gh workflow run build.yml -R "$full" -f reason=pages ;;
    *)
      say "Now run $full's Pages workflow yourself, then ./harness pages check $full"
      return 0
      ;;
  esac
  say "Redeploy dispatched: gh run list -R $full -L 2, watch it, then ./harness pages check $full"
}

# ---------------------------------------------------------------------------------------------------- labs

# LinuxServer Labs ($LABS_ORG): proposals become images through these. guides/playbooks/labs-image.md (the
# developer's side) and labs-accept.md (a member's) say when to use each. They read GitHub and write under
# .harness/labs/ only: nothing here creates a repository, pushes, comments or labels.
labs_py() { python3 "$here/scripts/labs.py" "$@"; }

cmd_labs() {
  local sub=${1:-}
  (( $# )) && shift
  case "$sub" in
    form) labs_form "$@" ;;
    scaffold) labs_scaffold "${1:?usage: ./harness labs scaffold <issue>}" ;;
    try) labs_try "$@" ;;
    accept) labs_accept "$@" ;;
    *) die "usage: ./harness labs form <name> | scaffold <issue> | try <issue> [--fresh] | try --stop <name> | accept <issue> [--fresh]" ;;
  esac
}

# The filled proposal draft as a prefilled link to the web form, and a clean body for gh as the fallback.
labs_form() {
  need python3
  local name draft
  name=$(image_name "${1:?usage: ./harness labs form <name>}")
  draft=$state/drafts/proposal-$name.md
  [[ -f "$draft" ]] || die "no draft: ./harness draft proposal $name first"
  if grep -q 'TODO' "$draft"; then
    warn "the draft still has TODOs: $(grep -c TODO "$draft") lines. Fill them (or answer _No response_ for an optional field) first."
  fi
  labs_py form --draft "$draft" --repo "$LABS_PROPOSALS" --body "$state/drafts/proposal-$name.body.md"
}

# Fetch a proposal and everything the scaffold needs, then write the image repo into .harness/labs/<name>/ and
# render its generated files with builder, as a Labs repository. Sets labs_dir and labs_name.
labs_dir="" labs_name=""
labs_scaffold() {
  need gh jq python3 docker
  local number=${1#\#} tmp parsed upstream host slug
  [[ "$number" =~ ^[0-9]+$ ]] || die "a proposal is an issue number in $LABS_PROPOSALS"
  tmp=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" RETURN
  gh issue view "$number" -R "$LABS_PROPOSALS" --json number,title,body,author,labels,url,state >"$tmp/issue.json" ||
    die "cannot read $LABS_PROPOSALS#$number"
  parsed=$(labs_py parse --issue "$tmp/issue.json") || die "$LABS_PROPOSALS#$number is not a proposal the scaffold can read"
  labs_name=$(jq -r '.name' <<<"$parsed")
  [[ "$labs_name" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || die "the proposal's image name ('$labs_name') is not a valid name"
  upstream=$(jq -r '.answers.upstream_repo // ""' <<<"$parsed")
  host=$(sed -E 's#^(https?://)?(www\.)?([^/]+)/.*#\3#' <<<"$upstream" | tr '[:upper:]' '[:lower:]')
  slug=$(sed -E 's#^(https?://)?[^/]+/([^/]+)/([^/#?]+).*#\2/\3#; s#\.git$##' <<<"$upstream")
  echo '{}' >"$tmp/repo.json"
  echo '{}' >"$tmp/release.json"
  case "$host" in
    github.com)
      gh api "repos/$slug" >"$tmp/repo.json" 2>/dev/null || warn "cannot read the upstream repository $slug"
      gh api "repos/$slug/releases/latest" >"$tmp/release.json" 2>/dev/null || warn "$slug has no latest stable release on GitHub"
      ;;
    codeberg.org)
      fetch "https://codeberg.org/api/v1/repos/$slug" >"$tmp/repo.json" 2>/dev/null || warn "cannot read $upstream"
      fetch "https://codeberg.org/api/v1/repos/$slug/releases/latest" >"$tmp/release.json" 2>/dev/null || warn "no latest release on $upstream"
      ;;
    *) warn "the upstream is on $host: the scaffold cannot read its releases, so the version source is left to you" ;;
  esac
  # A developer's own repository made from docker-template ("Working repository") is the starting point when the
  # proposal names one: its image.yml, Dockerfiles and root/ instead of a generated image. It is cloned, never run.
  local working working_args=()
  working=$(jq -r '.answers.working_repo // ""' <<<"$parsed" | tr -d '`' | sed 's/[[:space:]]*$//')
  if [[ -n "$working" ]]; then
    [[ "$working" =~ ^https://[A-Za-z0-9.-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/?$ ]] || die "the working repository is not an https repository URL: $working"
    if GIT_TERMINAL_PROMPT=0 git clone --quiet --depth 1 -- "${working%/}" "$tmp/working" 2>/dev/null; then
      working_args=(--working "$tmp/working")
      say "  starting from the working repository $working"
    else
      warn "cannot clone the working repository $working: generating the image from the form instead"
    fi
  fi
  labs_dir=$state/labs/$labs_name
  # A new scaffold replaces the old one; the notes of a trial of the same proposal are kept for labs accept.
  [[ -f "$labs_dir/.proposal/try.md" ]] && grep -q "labs try $number\b" "$labs_dir/.proposal/try.md" && cp "$labs_dir/.proposal/try.md" "$tmp/try.md"
  rm -rf "$labs_dir"
  mkdir -p "$labs_dir/.proposal"
  [[ -f "$tmp/try.md" ]] && mv "$tmp/try.md" "$labs_dir/.proposal/try.md"
  cp "$tmp"/*.json "$labs_dir/.proposal/"
  labs_py scaffold --issue "$tmp/issue.json" --repo "$tmp/repo.json" --release "$tmp/release.json" \
    --out "$labs_dir" --member "$(jq -r '.login // ""' "$profile" 2>/dev/null || true)" "${working_args[@]}" >/dev/null ||
    die "the scaffold failed"
  say "scaffold of $LABS_PROPOSALS#$number ($(jq -r .title "$tmp/issue.json")) in .harness/labs/$labs_name/"
  labs_render
}

# try and accept work on the scaffold already there for the issue, so a member's fixes to it are kept; --fresh
# (or no scaffold yet) writes it again from the issue.
labs_use() {
  local number=${1#\#} fresh=${2:-} found=""
  [[ "$number" =~ ^[0-9]+$ ]] || die "a proposal is an issue number in $LABS_PROPOSALS"
  if [[ "$fresh" != --fresh ]]; then
    found=$( (grep -l "\"number\": $number," "$state"/labs/*/.proposal/scaffold.json 2>/dev/null || true) | head -n1)
  fi
  if [[ -z "$found" ]]; then
    labs_scaffold "$number"
    return
  fi
  labs_dir=$(dirname "$(dirname "$found")")
  labs_name=$(basename "$labs_dir")
  say "using the scaffold of $LABS_PROPOSALS#$number in .harness/labs/$labs_name/ with your edits (--fresh writes it again from the issue)"
  labs_render
}

# The generated files a Labs repository gets, rendered as the live build would (its org, site and hub), then
# builder check with its Labs profile, then what is left to do.
labs_render() {
  local log=$labs_dir/.proposal/builder.log
  docker pull --quiet "$BUILDER_IMAGE" >/dev/null
  if labs_builder "$labs_dir" render >"$log" 2>&1; then
    say "  rendered: README.md, AGENTS.md, LICENSE and the workflows (builder render, as $LABS_ORG/docker-$labs_name)"
  else
    sed 's/^/  /' "$log"
    warn "builder render failed: fix image.yml in .harness/labs/$labs_name/ and run it again"
  fi
  if labs_builder "$labs_dir" check --drift warn >"$log" 2>&1; then
    say "  builder check (Labs profile): ok"
    echo ok >"$labs_dir/.proposal/check.txt"
  else
    sed 's/^/  /' "$log"
    cp "$log" "$labs_dir/.proposal/check.txt"
    warn "builder check failed: the findings above are in .harness/labs/$labs_name/.proposal/check.txt"
  fi
  labs_report "$labs_dir"
}

labs_builder() {
  local dir=$1
  shift
  docker run --rm -v "$dir":/repo --user "$(id -u):$(id -g)" \
    -e GITHUB_REPOSITORY="$LABS_ORG/docker-$labs_name" -e BUILDER_SITE_URL="$LABS_SITE" -e BUILDER_HUB_URL="$LABS_HUB" \
    "$BUILDER_IMAGE" "$@"
}

# What the scaffold could not tell from the proposal: said out loud, never guessed silently.
labs_report() {
  local meta=$1/.proposal/scaffold.json
  jq -r '"  upstream: \(.slug) at \(.tag // "?") (\(.source_type // "no typed source")); base \(.base) (\(.base_reason // "")); \(.platforms | join(", ")); maintainers \(.maintainers | join(", "))",
    (.assets | to_entries[] | "  asset \(.key): \(if .value.name != "" then .value.name else "NOT FOUND (" + .value.given + ")" end) -> require_assets \(.value.regex)"),
    "  start command: \(.command)"' "$meta"
  jq -r '.problems[] | "  proposal: \(.)"' "$meta"
  local todos
  todos=$(jq -r '.todos | length' "$meta")
  if (( todos > 0 )); then
    say "  TODO before this can be accepted ($todos; also marked TODO in the files):"
    jq -r '.todos[] | "    - \(.)"' "$meta"
  else
    say "  nothing left marked TODO by the scaffold"
  fi
}

labs_try() {
  need docker jq curl
  if [[ "${1:-}" == "--stop" ]]; then
    cmd_try --stop "${2:?usage: ./harness labs try --stop <name>}"
    docker rmi "harness-labs/$(image_name "$2"):try" >/dev/null 2>&1 || true
    return
  fi
  labs_use "${1:?usage: ./harness labs try <issue> [--fresh] | --stop <name>}" "${2:-}"
  local name=$labs_name dir=$labs_dir meta ref dockerfile=Dockerfile container
  meta=$dir/.proposal/scaffold.json
  container=harness-try-$name
  ref=harness-labs/$name:try
  if [[ "$(uname -m)" == "aarch64" || "$(uname -m)" == "arm64" ]]; then
    [[ -f "$dir/Dockerfile.aarch64" ]] || die "the proposal has no arm64 asset: try it on an amd64 machine"
    dockerfile=Dockerfile.aarch64
  fi
  say "building $ref ($dockerfile, --pull; a selkies base is a large first pull)"
  docker build --pull -f "$dir/$dockerfile" -t "$ref" "$dir" || die "the build failed: see the TODOs above and the Dockerfile in .harness/labs/$name/"
  # The sandbox: no host mounts (/config is an anonymous volume, removed with the container), no credentials or
  # host environment, and ports published on 127.0.0.1 only.
  # The previous trial goes first, so its ports are free again.
  docker rm -fv "$container" >/dev/null 2>&1 || true
  local args=(-d --name "$container" --pids-limit 4096 -e PUID="$(id -u)" -e PGID="$(id -g)" -e TZ=Etc/UTC)
  local selkies scheme=http urls=()
  selkies=$(jq -r '.selkies' "$meta")
  if [[ "$selkies" == true ]]; then
    args+=(--shm-size=1gb)
    scheme=https
  fi
  local internal host
  for internal in $(labs_ports "$dir/image.yml"); do
    host=$internal
    if (( host < 1024 )) || (ss -ltn 2>/dev/null | grep -q ":$host "); then host=$((18000 + internal % 1000)); fi
    args+=(-p "127.0.0.1:$host:$internal")
    urls+=("$internal=$host")
  done
  # Variables the proposal gives a value for; anything secret stays out of a proposal anyway.
  while IFS=$'\t' read -r key value; do
    [[ -n "$key" && -n "$value" ]] && args+=(-e "$key=$value")
  done < <(labs_py parse --issue "$dir/.proposal/issue.json" | jq -r '.env[] | "\(.name)\t\(.value)"')
  docker run "${args[@]}" "$ref" >/dev/null
  say "started $container (sandboxed: no host mounts, no credentials, localhost only); waiting for init"
  wait_for_init "$container" 600
  say "init done after ~${init_waited}s."
  # The generic smoke test: the web endpoint answers below 500 (ci's rule), retried while the app starts.
  local web_port web_scheme web_path code="000" waited=0 published=""
  web_port=$(awk '/^test:/ {t=1; next} /^[^ ]/ {t=0} t && /^    port:/ {print $2; exit}' "$dir/image.yml")
  web_scheme=$(awk '/^test:/ {t=1; next} /^[^ ]/ {t=0} t && /^    scheme:/ {print $2; exit}' "$dir/image.yml")
  web_path=$(awk '/^test:/ {t=1; next} /^[^ ]/ {t=0} t && /^    path:/ {print $2; exit}' "$dir/image.yml")
  for pair in "${urls[@]}"; do [[ "${pair%%=*}" == "$web_port" ]] && published=${pair#*=}; done
  if [[ -n "$published" ]]; then
    while (( waited < 120 )); do
      code=$(curl -ks -o /dev/null -w '%{http_code}' --max-time 10 "${web_scheme:-http}://127.0.0.1:$published${web_path:-/}" || true)
      [[ "$code" != "000" ]] && break
      sleep 5
      waited=$((waited + 5))
    done
  fi
  local verdict
  if [[ "$code" == "000" ]]; then verdict="FAIL: nothing answered on port $web_port within 120 s after init"
  elif (( code >= 500 )); then verdict="FAIL: the web endpoint answered $code"
  else verdict="ok: the web endpoint answered $code"
  fi
  say "smoke test: $verdict"
  # The application itself, not just the base's services: its start command's process.
  local program process="not checked"
  program=$(jq -r '.command // "" | split(" ")[0] | split("/")[-1]' "$meta")
  if [[ -n "$program" ]]; then
    sleep 10
    if docker exec "$container" pgrep -f "$program" >/dev/null 2>&1; then process="running ($program)"
    else process="NOT running: no process matches '$program' (the start command is wrong, or it exited: read the log)"
    fi
  fi
  say "application: $process"
  say "last log lines:"
  docker logs --tail 15 "$container" 2>&1 | sed 's/^/  /'
  say ""
  say "Open it:"
  for pair in "${urls[@]}"; do
    local url_scheme=$scheme
    [[ "$selkies" == true && "${pair%%=*}" == 3000 ]] && url_scheme=http
    [[ "${pair%%=*}" == "$web_port" ]] && url_scheme=${web_scheme:-http}
    say "  ${url_scheme}://localhost:${pair#*=}/  (container port ${pair%%=*})"
  done
  [[ "$selkies" == true ]] && say "  (selkies serves a self-signed certificate on 3001: accept the browser's warning)"
  say "What working looks like, from the proposal:"
  jq -r '.first_run // "" | split("\n")[] | "  " + .' "$meta"
  {
    say "\`./harness labs try $(jq -r .number "$meta")\` on $(date -u +%Y-%m-%d) ($(uname -m), $dockerfile, upstream $(jq -r '.tag // "?"' "$meta")):"
    say ""
    say "- builder check (Labs profile): $(head -n1 "$dir/.proposal/check.txt" 2>/dev/null || echo "not run")"
    say "- build: ok"
    say "- init: done after ~${init_waited}s"
    say "- smoke test: $verdict"
    say "- application: $process"
    say "- clicked through: TODO (what you checked against the proposal's first-run steps)"
  } >"$dir/.proposal/try.md"
  say ""
  say "Recorded in .harness/labs/$name/.proposal/try.md (labs accept puts it in the pull request; add what you clicked)."
  say "Stop and clean up: ./harness labs try --stop $name   (removes the container, its /config volume and the image)"
}

# The internal TCP ports image.yml publishes (runtime.ports).
labs_ports() {
  awk '/^runtime:/ {r=1; next} /^[^ ]/ {r=0} r && /^  ports:/ {p=1; next} r && /^  [a-z]/ {p=0}
       r && p && /internal:/ {gsub(/[^0-9\/a-z]/, "", $NF); sub(/\/tcp$/, "", $NF); if ($NF !~ /udp/) print $NF}' "$1" |
    sed 's/internal//'
}

labs_accept() {
  need gh jq python3
  local number=${1:?usage: ./harness labs accept <issue> [--fresh]}
  number=${number#\#}
  [[ "$(role)" == member ]] || die "accepting a proposal is for members: on the contributor path, the proposal itself is your part (guides/roles/labs-developer.md)"
  [[ "$(jq -r '.labs_member // false' "$profile")" == true ]] ||
    die "you are not a member of $LABS_ORG (./harness whoami --refresh if you were just added): ask a Labs admin to accept it"
  labs_use "$number" "${2:-}"
  local name=$labs_name dir=$labs_dir
  if gh repo view "$LABS_ORG/docker-$name" --json name >/dev/null 2>&1; then
    warn "$LABS_ORG/docker-$name already exists: accept.sh would fail when it creates it. Work on that repository instead."
  fi
  # Unique across Labs, the main org and live linuxserver, so graduation never collides (reads only).
  gh repo view "$ORG/docker-$name" --json name >/dev/null 2>&1 && warn "$ORG/docker-$name exists: the name collides with the main org"
  gh repo view "linuxserver/docker-$name" --json name >/dev/null 2>&1 && warn "linuxserver/docker-$name exists: the name collides with live LinuxServer"
  [[ -f "$dir/.proposal/try.md" ]] || warn "no trial recorded: run ./harness labs try $number and look at it before accepting"
  if [[ "$(jq -r '[.labels[].name] | index("meets-bar") != null' "$dir/.proposal/issue.json")" != true ]]; then
    warn "the proposal is not labelled meets-bar: read the check's comment on the issue first"
  fi
  labs_py accept --dir "$dir" --member "$(jq -r '.login // ""' "$profile")"
  say ""
  say "Prepared, not run. Read these, then run them yourself (or let the agent, once you say so):"
  say "  .harness/labs/$name/accept.sh        the repo, with docker-template's pending branch as main (proposal linked, build.yml),"
  say "                                       Pages, labs-pending, the image on 'initial' and its pull request, the issue accepted"
  say "  .harness/labs/$name/after-merge.sh   once the pull request merges: remove labs-pending, dispatch the first build"
  say "  .harness/labs/$name/.proposal/pr-body.md   the pull request's description (fill its AI-use line and trial notes)"
  say ""
  sed 's/^/    /' "$dir/accept.sh"
}

# ---------------------------------------------------------------------------------------------------- main

usage() { sed -n '2,36p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
  local cmd=${1:-help}
  (( $# )) && shift
  case "$cmd" in
    whoami) need jq; cmd_whoami "$@" ;;
    doctor) cmd_doctor ;;
    core) cmd_core ;;
    get) cmd_get "$@" ;;
    all) cmd_all ;;
    sync) cmd_sync ;;
    fork) cmd_fork "$@" ;;
    setup) cmd_setup "$@" ;;
    control) cmd_control "$@" ;;
    snapshot) cmd_snapshot ;;
    lookup) cmd_lookup "$@" ;;
    data) cmd_data ;;
    try) cmd_try "$@" ;;
    render) cmd_render "$@" ;;
    validate) cmd_validate "$@" ;;
    draft) need jq; cmd_draft "$@" ;;
    allow) cmd_allow "$@" ;;
    pages) cmd_pages "$@" ;;
    labs) cmd_labs "$@" ;;
    version | --version) say "harness $VERSION" ;;
    help | -h | --help) usage ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
