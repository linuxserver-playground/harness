{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(./harness whoami:*)",
      "Bash(./harness doctor)",
      "Bash(./harness core)",
      "Bash(./harness get:*)",
      "Bash(./harness sync)",
      "Bash(./harness snapshot)",
      "Bash(./harness lookup:*)",
      "Bash(./harness render:*)",
      "Bash(./harness validate:*)",
      "Bash(./harness draft:*)",
      "Bash(./harness version)",
      "Bash(./harness help)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh repo list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh search issues:*)",
      "Bash(gh search prs:*)",
      "Bash(gh label list:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker images:*)",
      "Bash(docker image ls:*)",
      "Bash(docker manifest inspect:*)",
      "Bash(docker buildx imagetools inspect:*)",
      "Bash(jq:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format --check:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(curl -fsS https://ci.thelamer.duckdns.org:8443/*)",
      "Bash(curl -fsS https://linuxserver-playground.github.io/*)"
    ],
    "deny": [
      "Bash(gh pr create --repo linuxserver/*)",
      "Bash(gh pr create -R linuxserver/*)",
      "Bash(gh issue create --repo linuxserver/*)",
      "Bash(gh issue create -R linuxserver/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py"
          }
        ]
      }
    ]
  }
}
